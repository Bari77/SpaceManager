<Window x:Class="SpaceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SpaceManager.Models"
        xmlns:converters="clr-namespace:SpaceManager.Converters"
        Title="SpaceManager"
        Height="720"
        Width="1150"
        MinHeight="480"
        MinWidth="900"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <converters:IndentConverter x:Key="IndentConverter"/>
        <converters:RatioWidthConverter x:Key="RatioWidthConverter"/>
        <Storyboard x:Key="RowSkeletonPulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.35"
                             To="0.8"
                             Duration="0:0:0.85"
                             AutoReverse="True"/>
        </Storyboard>

        <Style x:Key="SkeletonBar" TargetType="Border">
            <Setter Property="Background" Value="#4A4A4F"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource RowSkeletonPulseStoryboard}"/>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SizeStatusText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Node.IsQueued}" Value="True">
                    <Setter Property="Foreground" Value="#888888"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.ShowsAnalysisProgress}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontStyle" Value="Normal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SortHeaderButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <Image Source="pack://application:,,,/Assets/space-manager-logo.png"
                           Width="36"
                           Height="36"
                           Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SpaceManager"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="Analyse des tailles de dossiers"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Dossier analysé"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"
                           Margin="0,0,0,6"/>

                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Total : "
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="RootSizeText"
                               Foreground="{StaticResource AccentBrush}"
                               FontFamily="Consolas"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="PathTextBox"
                             KeyDown="PathTextBox_KeyDown"
                             LostFocus="PathTextBox_LostFocus"/>

                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Content="Aller"
                            Click="NavigatePath_Click"/>

                    <Button Grid.Column="2"
                            Margin="8,0,0,0"
                            Content="Parcourir…"
                            Click="BrowseFolder_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Border Margin="12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1"
                CornerRadius="6">
            <ListView x:Name="FolderList"
                      ItemsSource="{Binding Rows}"
                      Padding="4,6"
                      FocusVisualStyle="{x:Null}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="360">
                            <GridViewColumn.Header>
                                <Button x:Name="NameSortHeader"
                                        Style="{StaticResource SortHeaderButton}"
                                        Tag="Name"
                                        Content="Nom"
                                        Click="SortHeader_Click"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:TreeRow}">
                                    <Grid VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSkeleton}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOverflow}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Width="18"
                                                    Height="18"
                                                    Margin="{Binding Depth, Converter={StaticResource IndentConverter}}"
                                                    Padding="0"
                                                    FontSize="10"
                                                    Click="ExpandToggle_Click"
                                                    Tag="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Content" Value="▶"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanExpand}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Node.IsExpanded}" Value="True">
                                                                <Setter Property="Content" Value="▼"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,6,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE8B7;"/>
                                                        <Setter Property="Foreground" Value="{StaticResource FolderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Node.IsDirectory}" Value="False">
                                                                <Setter Property="Text" Value="&#xE7C3;"/>
                                                                <Setter Property="Foreground" Value="{StaticResource FileBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Node.Name}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Text="&#xE712;">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Node.IsQueued}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Foreground" Value="#888888"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Node.ShowsAnalysisProgress}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                <Setter Property="Text" Value="&#xE768;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <Border Width="160"
                                                Height="14"
                                                Margin="{Binding Depth, Converter={StaticResource IndentConverter}}"
                                                Visibility="Collapsed">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource SkeletonBar}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSkeleton}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <TextBlock Text="{Binding OverflowText}"
                                                   Margin="{Binding Depth, Converter={StaticResource IndentConverter}}"
                                                   VerticalAlignment="Center"
                                                   FontStyle="Italic"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Visibility="Collapsed">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverflow}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="220">
                            <GridViewColumn.Header>
                                <TextBlock Text="Utilisation"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontWeight="SemiBold"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:TreeRow}">
                                    <Grid VerticalAlignment="Center" Margin="0,2">
                                        <Grid x:Name="UsageCell"
                                              Height="16"
                                              HorizontalAlignment="Stretch">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSkeleton}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Border Background="{StaticResource BarTrackBrush}"
                                                    CornerRadius="3"/>

                                            <Border CornerRadius="3"
                                                    HorizontalAlignment="Left">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource RatioWidthConverter}">
                                                        <Binding ElementName="UsageCell" Path="ActualWidth"/>
                                                        <Binding Path="Node.SizeRatio"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Node.IsSizeReady}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Node.IsDirectory}" Value="False">
                                                                <Setter Property="Background" Value="{StaticResource FileBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <Border HorizontalAlignment="Left"
                                                    Background="#4A4A4F"
                                                    CornerRadius="3"
                                                    Opacity="0.45"
                                                    Height="16"
                                                    Visibility="Collapsed">
                                                <Border.Width>
                                                    <Binding ElementName="UsageCell" Path="ActualWidth"/>
                                                </Border.Width>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Node.IsQueued}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard Storyboard="{StaticResource RowSkeletonPulseStoryboard}"/>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                            </Border>

                                            <ProgressBar IsIndeterminate="True">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource SizeProgressBar}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Node.ShowsAnalysisProgress}" Value="True"/>
                                                                <Condition Binding="{Binding Node.IsQueued}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </Grid>

                                        <Border Height="16"
                                                Visibility="Collapsed">
                                            <Border.Width>
                                                <Binding ElementName="UsageCell" Path="ActualWidth"/>
                                            </Border.Width>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource SkeletonBar}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSkeleton}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="110">
                            <GridViewColumn.Header>
                                <Button x:Name="SizeSortHeader"
                                        Style="{StaticResource SortHeaderButton}"
                                        Tag="Size"
                                        Content="Taille"
                                        HorizontalContentAlignment="Right"
                                        Click="SortHeader_Click"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:TreeRow}">
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Node.FormattedSize}"
                                                   Visibility="Visible">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SizeStatusText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSkeleton}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Width="56"
                                                Height="14"
                                                HorizontalAlignment="Right"
                                                Visibility="Collapsed">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource SkeletonBar}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSkeleton}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
